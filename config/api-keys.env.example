# Public Desk API keys for the Open OSINT data service.
#
# Start Public Desk.command copies this file to work/api-keys.env the first time it runs. Put your keys in
# work/api-keys.env (never in this file): that folder is not committed and only your account can read it.
# The easiest way to manage keys is Public Desk → MCP servers → Data sources: Connect, Disconnect and Remove
# apply right away. To edit this file by hand instead, paste each key right after the "=" (a line left empty
# keeps that source off); the data service picks up the change within a second.

# Live vessel positions (maritime searches with coordinates). Free: https://aisstream.io (sign in with GitHub).
# Not useful yet: Open OSINT's AIS module calls api.aisstream.io, which does not exist (AISStream only offers a
# WebSocket stream), so a key changes the error but returns no vessels.
AISSTREAM_API_KEY=

# AlienVault OTX threat indicators (cyber searches). Free account: https://otx.alienvault.com
OTX_API_KEY=

# AbuseIPDB abuse reports (cyber searches). Free tier with a daily quota: https://www.abuseipdb.com
ABUSEIPDB_API_KEY=

# Intelligence X search (get_intelx). Limited free tier: https://intelx.io
INTELX_API_KEY=
# Leave empty for a free key (Public Desk uses https://free.intelx.io). A paid key: https://2.intelx.io
INTELX_API_ORIGIN=

# ── Other sources Open OSINT can use (all optional) ──

# abuse.ch: one free Auth-Key covers MalwareBazaar (file hashes), ThreatFox and URLhaus. https://auth.abuse.ch
URLHAUS_AUTH_KEY=

# Satellite fire detections. Free map key: https://firms.modaps.eosdis.nasa.gov/api/
NASA_FIRMS_API_KEY=

# US economic series. Free: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# US energy data. Free: https://www.eia.gov/opendata/
EIA_API_KEY=

# Market quotes. Free tier: https://finnhub.io
FINNHUB_API_KEY=

# Stock quotes and profiles. Small free quota: https://financialmodelingprep.com
FMP_API_KEY=

# Conflict events. Free for non-commercial use: https://acleddata.com (token plus your account's email)
ACLED_ACCESS_TOKEN=
ACLED_EMAIL=

# IP noise and scanner data. Community tier: https://www.greynoise.io
GREYNOISE_API_KEY=

# NOTAMs. Free after FAA approval: https://api.faa.gov
FAA_NOTAM_API_KEY=

# Company registers. Generally paid: https://opencorporates.com
OPENCORPORATES_API_KEY=
